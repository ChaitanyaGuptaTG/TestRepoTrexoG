<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO" packages="utils.logging">

    <Appenders>

        <!-- Console logs -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level %c{1} - %msg%n"/>
        </Console>

        <!-- File logs -->
        <File name="FileLogger" fileName="logs/application.log" append="true">
            <PatternLayout>
                <Pattern>%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1} - %m%n</Pattern>
            </PatternLayout>
        </File>

        <!-- Mirrors log lines into a per-thread buffer so ExtentTestListener can attach
             them to the correct test's node in the Extent Report -->
        <ExtentTestAppender name="ExtentCapture">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %c{1} - %msg%n"/>
        </ExtentTestAppender>

    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileLogger"/>
            <AppenderRef ref="ExtentCapture"/>
        </Root>
    </Loggers>

</Configuration>